# This project runs React 19, but vaul@0.9.9 still declares a peer range of
# ^16.8 || ^17 || ^18, so a clean `npm install` fails on ERESOLVE. Every local
# install has used --legacy-peer-deps; this makes the build hosts do the same
# instead of failing.
#
# Remove this once vaul (and any other stragglers) publish React 19 peer ranges.
legacy-peer-deps=true
